@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run dev-install >/dev/null && python -m unittest tests/test_agent_skills.py tests/test_spec_kit_runtime_projection.py tests/test_distribution_surface.py"
@cli! bash -lic "printf '%s\n' '--- Spec Kit script-mode selection and prerequisites ---'; git grep -n -E 'BOUNDARY_SPECKIT_SCRIPT|init-options\\.json|check-prerequisites|pwsh|powershell/|scripts/bash|scripts/python|script[- ]mode|selected.*script' -- README.md docs integration/speckit integration/speckit-preset src/boundary/cli tests 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Spec Kit host lifecycle and generated integration handling ---'; git grep -n -E 'integration install|integration check|integration remove|host_install|host_check|generated_state|materializ|generated script|patch|write_text|unlink' -- README.md docs integration/speckit src/boundary/cli tests/test_distribution_surface.py tests/test_mise_distribution_integration.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Active-feature and BRANCH semantics ---'; git grep -n -E 'SPECIFY_FEATURE_DIRECTORY|\\bBRANCH\\b|active_feature|feature_dir|feature directory|git branch' -- docs integration/speckit integration/speckit-preset tests/test_spec_kit_runtime_projection.py tests/test_distribution_surface.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Ignore-file planning and declared-scope readiness ---'; git grep -n -E '\\.gitignore|ignore[- ]file|declared-scope preflight|durable project|Writes:' -- docs/spec-agent-instructions.md docs/spec-change-adapter.md docs/spec-lifecycle.md skills/scope/SKILL.md integration/speckit-preset integration/speckit/runtime/boundary_host tests/test_agent_skills.py tests/test_spec_kit_runtime_projection.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Historical runtime/setup incidents ---'; grep -n -E 'script mode|Bash|PowerShell|pwsh|BRANCH|gitignore|Ignore-file' ../gui-auto2/BOUNDARY-FEEDBACK.md ../gui-auto2/BOUNDARY-FEEDBACK-REVIEW1.md 2>/dev/null || true"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
