@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -v tests.test_agent_skills tests.test_preset tests.test_spec_kit_adapter"
@cli! bash -lic "python -c 'from pathlib import Path; files=[Path(\"skills/scope/SKILL.md\"),Path(\"tests/test_agent_skills.py\"),Path(\"tests/test_preset.py\"),Path(\"tests/test_spec_kit_adapter.py\")]; files += list(Path(\"integration/speckit\").rglob(\"*.py\")); files += list(Path(\"integration/speckit/commands\").rglob(\"*.md\")); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files if p.is_file()]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in sorted(oversized) if count > 250]'"
