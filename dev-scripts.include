@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "printf '%s\n' '--- Toolchain versions ---'; mise --version; uv --version; python --version"
@cli! bash -lic 'set +e; tmp=$(mktemp -d); src="$tmp/boundary-src"; proj="$tmp/direct"; aliasproj="$tmp/alias"; badproj="$tmp/bad"; mkdir -p "$src/src/boundary_probe" "$proj" "$aliasproj" "$badproj" "$tmp/config-alias"; git init -q "$src"; git -C "$src" config user.email probe@example.invalid; git -C "$src" config user.name probe; printf "%s\n" "[build-system]" "requires = [\"setuptools>=68\"]" "build-backend = \"setuptools.build_meta\"" "" "[project]" "name = \"boundary-probe\"" "version = \"0.0.0\"" "requires-python = \">=3.11\"" "" "[project.scripts]" "boundary = \"boundary_probe.cli:main\"" "" "[tool.setuptools.packages.find]" "where = [\"src\"]" > "$src/pyproject.toml"; : > "$src/src/boundary_probe/__init__.py"; printf "%s\n" "def main():" "    print(\"boundary-probe-A\")" > "$src/src/boundary_probe/cli.py"; git -C "$src" add .; git -C "$src" commit -qm A; a=$(git -C "$src" rev-parse HEAD); printf "%s\n" "def main():" "    print(\"boundary-probe-B\")" > "$src/src/boundary_probe/cli.py"; git -C "$src" add .; git -C "$src" commit -qm B; b=$(git -C "$src" rev-parse HEAD); printf "%s\n" "[settings]" "lockfile = true" "" "[tools]" "\"pypi:git+file://$src\" = \"$a\"" > "$proj/mise.toml"; export MISE_TRUSTED_CONFIG_PATHS="$tmp"; export MISE_CONFIG_DIR="$tmp/config-direct"; export MISE_STATE_DIR="$tmp/state-direct"; export MISE_DATA_DIR="$tmp/data-direct"; export MISE_CACHE_DIR="$tmp/cache-direct"; mkdir -p "$MISE_CONFIG_DIR"; printf "%s\n" "--- Direct local Git source ---" "requested=$a" "source_head=$b"; (cd "$proj" && mise lock); direct_lock=$?; printf "direct_lock_status=%s\n" "$direct_lock"; if [ "$direct_lock" -eq 0 ]; then sed -n "1,160p" "$proj/mise.lock"; grep -F "$a" "$proj/mise.lock" >/dev/null; printf "lock_contains_requested_revision=%s\n" "$?"; if grep -F "$src" "$proj/mise.lock" >/dev/null; then echo "lock_contains_operator_path=yes"; else echo "lock_contains_operator_path=no"; fi; printf "%s\n" "--- Dependency sidecars ---"; find "$proj/.mise/locks" -maxdepth 5 -type f -print 2>/dev/null | sort; (cd "$proj" && mise install --locked); printf "direct_install_locked_status=%s\n" "$?"; (cd "$proj" && mise exec -- boundary); printf "direct_exec_status=%s\n" "$?"; printf "%s\n" "# dirty worktree" >> "$src/src/boundary_probe/cli.py"; printf "%s\n" "--- Source checkout after dirtying ---"; git -C "$src" status --short; export MISE_CONFIG_DIR="$tmp/config-dirty"; export MISE_STATE_DIR="$tmp/state-dirty"; export MISE_DATA_DIR="$tmp/data-dirty"; export MISE_CACHE_DIR="$tmp/cache-dirty"; mkdir -p "$MISE_CONFIG_DIR"; (cd "$proj" && mise install --locked); printf "dirty_source_install_locked_status=%s\n" "$?"; (cd "$proj" && mise exec -- boundary); printf "dirty_source_exec_status=%s\n" "$?"; cp "$proj/mise.lock" "$proj/mise.lock.good"; : > "$proj/mise.lock"; export MISE_CONFIG_DIR="$tmp/config-incomplete"; export MISE_STATE_DIR="$tmp/state-incomplete"; export MISE_DATA_DIR="$tmp/data-incomplete"; export MISE_CACHE_DIR="$tmp/cache-incomplete"; mkdir -p "$MISE_CONFIG_DIR"; (cd "$proj" && mise install --locked); printf "incomplete_lock_install_status=%s\n" "$?"; mv "$proj/mise.lock.good" "$proj/mise.lock"; fi; printf "%s\n" "[settings]" "lockfile = true" "" "[tools]" "boundary = \"$a\"" > "$aliasproj/mise.toml"; printf "%s\n" "[tool_alias]" "boundary = \"pypi:git+file://$src\"" > "$tmp/config-alias/config.toml"; export MISE_CONFIG_DIR="$tmp/config-alias"; export MISE_STATE_DIR="$tmp/state-alias"; export MISE_DATA_DIR="$tmp/data-alias"; export MISE_CACHE_DIR="$tmp/cache-alias"; printf "%s\n" "--- Operator-local backend alias ---"; (cd "$aliasproj" && mise lock); alias_lock=$?; printf "alias_lock_status=%s\n" "$alias_lock"; if [ "$alias_lock" -eq 0 ]; then sed -n "1,160p" "$aliasproj/mise.lock"; if grep -F "$src" "$aliasproj/mise.toml" "$aliasproj/mise.lock" >/dev/null; then echo "alias_project_state_contains_operator_path=yes"; else echo "alias_project_state_contains_operator_path=no"; fi; printf "%s\n" "--- Alias dependency sidecars ---"; find "$aliasproj/.mise/locks" -maxdepth 5 -type f -print 2>/dev/null | sort; (cd "$aliasproj" && mise install --locked); printf "alias_install_locked_status=%s\n" "$?"; (cd "$aliasproj" && mise exec -- boundary); printf "alias_exec_status=%s\n" "$?"; fi; bad=ffffffffffffffffffffffffffffffffffffffff; printf "%s\n" "[settings]" "lockfile = true" "" "[tools]" "\"pypi:git+file://$src\" = \"$bad\"" > "$badproj/mise.toml"; export MISE_CONFIG_DIR="$tmp/config-bad"; export MISE_STATE_DIR="$tmp/state-bad"; export MISE_DATA_DIR="$tmp/data-bad"; export MISE_CACHE_DIR="$tmp/cache-bad"; mkdir -p "$MISE_CONFIG_DIR"; printf "%s\n" "--- Unavailable revision ---"; (cd "$badproj" && mise lock); bad_lock=$?; printf "unavailable_revision_lock_status=%s\n" "$bad_lock"; if [ -f "$badproj/mise.lock" ]; then sed -n "1,120p" "$badproj/mise.lock"; (cd "$badproj" && mise install --locked); printf "unavailable_revision_install_status=%s\n" "$?"; fi; rm -rf "$tmp"; exit 0'
@cli! bash -lic "printf '%s\n' '--- Files with obsolete distribution references ---'; git grep -l -E 'boundary\\.lock\\.json|boundary\\.lock/v[0-9]+|source-checkout|source checkout|committed lock|matching checkout|Boundary source revision|source pin' -- . ':(exclude)docs/history/**' ':(exclude).agents/**' ':(exclude).specify/**' ':(exclude).boundary/**' | sort || true"
