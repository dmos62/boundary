@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run test"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Operation-evidence persistence references ---"; git grep -n -E "current_operation_path|operation_archive_path|read_current_operation|write_current_operation|GIT_STATE_UNAVAILABLE|MISSING_EXTERNAL_PREREQUISITE|boundary/current\\.json|\\.git/boundary" -- src integration tests docs 2>/dev/null || true'
@cli! bash -lic 'printf "%s\n" "--- Persistence target Boundary context ---"; boundary inspect src/boundary/authorization/storage.py src/boundary/authorization/service.py src/boundary/verification.py integration/speckit/runtime/boundary_host/commands.py'
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
