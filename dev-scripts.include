@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -v tests.test_consumer_lifecycle tests.test_consumer_state"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -v tests.test_install_real_cli"
@cli! bash -lic "python -c 'from pathlib import Path; roots=(Path(\"scripts\"),Path(\"tests\")); names={\"consumer.py\",\"consumer_lock.py\",\"consumer_source.py\",\"consumer_state.py\",\"project_boundary.py\",\"consumer_test_support.py\",\"install_real_cli_support.py\",\"test_consumer_lifecycle.py\",\"test_consumer_state.py\",\"test_install_real_cli.py\"}; files=(p for root in roots for p in root.rglob(\"*.py\") if p.name in names); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in sorted(oversized) if count > 250]'"
