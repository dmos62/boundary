@cli! bash -lic 'printf "%s\n" "--- Boundary integration health ---"; mise exec -- boundary integration check && test ! -e .specify/boundary-runtime'
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Canonical changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "\*.py" "\*.md" "\*.toml" "\*.yml" "\*.yaml" ":(exclude).agents/\*\*" ":(exclude).specify/\*\*"); exit "$failed"'
@cli! bash -lic 'printf "%s\n" "--- Repository status ---"; git status --short'
