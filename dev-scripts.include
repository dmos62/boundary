@cli! bash -lic "mise run dev-install && python -m unittest discover -s tests -p 'test_boundary_status_cli.py' && python -m unittest discover -s tests -p 'test_spec_kit_authorization_cli.py' && python -m unittest discover -s tests -p 'test_spec_kit_runtime_projection.py'"
@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run test"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
