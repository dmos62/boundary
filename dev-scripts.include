@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "printf '%s\n' '--- Boundary lock/source-checkout references ---'; git grep -n -E 'boundary\.lock\.json|boundary\.lock/v[0-9]+|source-checkout|source checkout|committed lock|matching checkout|Boundary source revision|source pin' -- . ':(exclude)docs/history/**' ':(exclude).agents/**' ':(exclude).specify/**' ':(exclude).boundary/**' || true"
@cli! bash -lic "printf '%s\n' '--- Existing mise and Python packaging files ---'; git ls-files | grep -E '(^|/)(mise(\.[^.]+)?\.toml|mise(\.[^.]+)?\.lock|pyproject\.toml|uv\.lock)$' || true; printf '%s\n' '--- mise version ---'; mise --version"
