@cli! bash -lic "mise run contracts-check"
@cli! bash -lic 'for pattern in test_contract_evolution_cli.py test_native_verification.py test_operation_record.py test_lifecycle_outcomes.py; do printf "%s\n" "--- $pattern ---"; mise exec -- python -m unittest discover -s tests -p "$pattern" -v || exit 1; done'
@cli! bash -lic 'printf "%s\n" "--- Boundary integration health ---"; mise exec -- boundary integration check'
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Boundary CLI surface ---"; mise exec -- boundary --version; mise exec -- boundary --help; printf "%s\n" "--- boundary contracts help ---"; mise exec -- boundary contracts --help; printf "%s\n" "--- boundary contracts authorize help ---"; mise exec -- boundary contracts authorize --help'
@cli! bash -lic 'printf "%s\n" "--- Feedback-audit implementation references ---"; git grep -n -E "selectedTaskIds|declared write target appears in multiple tasks|boundary.lifecycle-result/v1|check_operation_evidence_persistence|OPERATION_EVIDENCE_UNAVAILABLE|BOUNDARY_TASK_IDS|integration check|contracts authorize" -- src integration/speckit/runtime/boundary_host docs skills tests 2>/dev/null | head -n 280 || true'
@cli! bash -lic 'printf "%s\n" "--- CLI parser and dispatch references ---"; git grep -n -E "ArgumentParser|add_parser|add_subparsers|def main|project.scripts" -- src pyproject.toml 2>/dev/null | head -n 140 || true'
@cli! bash -lic 'printf "%s\n" "--- Focused contract-evolution diff ---"; git diff -- TODO.md files.include dev-scripts.include src/boundary/cli skills/contracts tests/test_contract_evolution_cli.py docs/spec-contracts.md docs/spec-authorization.md docs/spec-lifecycle.md docs/spec-agent-instructions.md'
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
