@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run dev-install >/dev/null && python -m unittest tests/test_agent_skills.py tests/test_spec_kit_runtime_projection.py tests/test_native_verification.py tests/test_lifecycle_outcomes.py"
@cli! bash -lic "printf '%s\n' '--- Workflow-record planning and preflight semantics ---'; git grep -n -E 'workflow record|durable project record|checkpoint|continuation|feedback|Writes:|declared-scope preflight|preflight_declared_scope' -- docs/spec-agent-instructions.md docs/spec-change-adapter.md docs/spec-lifecycle.md skills/boundary-scope integration/speckit-preset integration/speckit/runtime/boundary_host/adapter.py tests/test_agent_skills.py tests/test_spec_kit_runtime_projection.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Workflow-record ownership and bookkeeping classification ---'; git grep -n -E 'ordinary write|bookkeeping|change-system|generated|UNOWNED_WRITE_TARGET|authorized target|native contract' -- docs/spec-authorization.md docs/spec-change-adapter.md docs/spec-lifecycle.md src/boundary/verification/checks.py integration/speckit/runtime/boundary_host/adapter.py tests/test_native_verification.py tests/test_lifecycle_outcomes.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Universal workflow-record special-case search ---'; git grep -n -E 'workflow[- ]record|project-records|CONTINUATION\.md|BOUNDARY-FEEDBACK\.md|cross-feature' -- README.md docs contracts skills integration src tests 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Historical workflow-record incident ---'; grep -n -E 'CONTINUATION\.md|BOUNDARY-FEEDBACK\.md|project-records|cross-feature' ../gui-auto2/BOUNDARY-FEEDBACK.md ../gui-auto2/BOUNDARY-FEEDBACK-REVIEW1.md 2>/dev/null || true"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "\\*.py" "\\*.md" "\\*.toml" "\\*.yml" "\\*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
