@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run dev-install >/dev/null && python -m unittest tests/test_spec_kit_runtime_projection.py tests/test_task_selected_units.py tests/test_operation_record_task_selection.py tests/test_authorization_model.py tests/test_authorization_lifecycle.py tests/test_fresh_authorization.py tests/test_lifecycle_outcomes.py tests/test_native_verification.py"
@cli! bash -lic "printf '%s\n' '--- Structured task scope and explicit selection ---'; git grep -n -E 'Writes:|selected_task_ids|BOUNDARY_TASK_IDS|project_change|parse_tasks|authorize_feature|preflight_declared_scope' -- docs/spec-authorization.md docs/spec-change-adapter.md docs/spec-lifecycle.md src/boundary/authorization integration/speckit tests/test_spec_kit_runtime_projection.py tests/test_task_selected_units.py tests/test_operation_record_task_selection.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Verification history and bookkeeping classification ---'; git grep -n -E 'classify_path|path_classifier|change-system|authorizedTargets|authorized_targets|UNDECLARED_WRITE|UNOWNED_WRITE_TARGET|OPERATION_CHANGED|contract' -- src/boundary/verification integration/speckit/runtime/boundary_host tests/test_native_verification.py tests/test_spec_kit_runtime_projection.py tests/test_lifecycle_outcomes.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Feature-wide authorization regression search ---'; git grep -n -E 'feature-wide|whole-feature|flatten(ed|ing)?|implicit.*all.*task|all.*task.*authoriz|change\\.writes' -- src/boundary integration/speckit contracts docs/spec-authorization.md docs/spec-change-adapter.md docs/spec-lifecycle.md tests/test_spec_kit_runtime_projection.py tests/test_task_selected_units.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Adapter-focused evidence files ---'; git ls-files 'tests/test_spec_kit_runtime_projection.py' 'tests/test_task_selected_units.py' 'tests/test_operation_record_task_selection.py' 'tests/test_authorization_model.py' 'tests/test_authorization_lifecycle.py' 'tests/test_fresh_authorization.py' 'tests/test_lifecycle_outcomes.py' 'tests/test_native_verification.py'"
@cli! bash -lic "mise run test"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "\\*.py" "\\*.md" "\\*.toml" "\\*.yml" "\\*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
