@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=scripts:tests uv run --no-project python -m unittest -q tests.test_consumer_lock tests.test_consumer_source_integrity tests.test_consumer_state tests.test_consumer_lifecycle tests.test_install_host_script_mode"
@cli! bash -lic "python -c 'from pathlib import Path; roots=(Path(\"scripts\"),Path(\"tests\"),Path(\"docs\"),Path(\"contracts\")); suffixes={\".py\",\".sh\",\".md\",\".yml\",\".yaml\"}; files=(p for root in roots if root.exists() for p in root.rglob(\"*\") if p.is_file() and p.suffix in suffixes and \"__pycache__\" not in p.parts); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in sorted(oversized) if count > 250]'"
