@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "printf '%s\n' '--- Handoff and operation-state test evidence ---'; git grep -n -C 3 -E 'authorization-handoff|selectedTaskIds|selected_task_ids|read_authorization_handoff|headMatchesBaseline|NO_ACTIVE_OPERATION|OPERATION_CHANGED|status.*verified|kind.*implementation|kind.*contract-evolution' -- tests 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Lifecycle outcome test evidence ---'; git grep -n -C 3 -E 'scope-expansion-required|contract-evolution-required|missing-external-prerequisite|stale-authorization|verification-write-scope-failure|INVALID_TASK_SELECTION|UNDECLARED_WRITE|UNOWNED_WRITE_TARGET|CONTRACT_CONTEXT_CHANGED' -- tests 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Spec Kit status and feature-match implementation/tests ---'; git grep -n -C 3 -E 'handoff|status|change.*match|feature.*match|active.*feature|wrong.*kind|verified' -- integration/speckit/runtime tests 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Test files ---'; git ls-files 'tests/*.py'"
@cli! bash -lic "mise run test"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
