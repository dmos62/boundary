@cli! bash -lic 'printf "%s\n" "--- Current Boundary operation handoff ---"; mise exec -- boundary status'
@cli! bash -lic 'printf "%s\n" "--- Native contract validation ---"; mise exec -- boundary contracts check'
@cli! bash -lic 'printf "%s\n" "--- Contract ownership and applicable scopes ---"; for file in contracts/*.contract.md; do [ -f "$file" ] || continue; printf "\n%s\n" "$file"; grep -nE "^(id:|owns:|applies_to:|depends_on:|  - )" "$file" || true; done'
@cli! bash -lic 'printf "%s\n" "--- Downstream Feature 005 context (read-only) ---"; if [ -d ../gui-auto2 ]; then (cd ../gui-auto2 && mise exec -- boundary inspect specs/005-dev-chrome-session/contracts/cli.md apps/chrome-dev-session/src/cli.rs apps/chrome-dev-session/tests/cli.rs); else printf "%s\n" "Downstream repository unavailable"; fi'
@cli! bash -lic 'printf "%s\n" "--- Downstream operation handoff (read-only) ---"; if [ -d ../gui-auto2 ]; then (cd ../gui-auto2 && mise exec -- boundary status); else printf "%s\n" "Downstream repository unavailable"; fi'
@cli! bash -lic 'printf "%s\n" "--- Installed contract-evolution executable tests ---"; mise exec -- python -m unittest discover -s tests -p "test_installed_contract_evolution_workflow.py" -v'
@cli! bash -lic 'printf "%s\n" "--- Contract-evolution CLI regressions ---"; mise exec -- python -m unittest discover -s tests -p "test_contract_evolution*.py" -v'
@cli! bash -lic 'printf "%s\n" "--- Native contract graph and context tests ---"; mise exec -- python -m unittest discover -s tests -p "test_native_contract_graph.py" -v && mise exec -- python -m unittest discover -s tests -p "test_native_contract_context.py" -v'
@cli! bash -lic 'printf "%s\n" "--- Mise distribution tests ---"; mise exec -- python -m unittest discover -s tests -p "test_mise_distribution*.py" -v'
@cli! bash -lic 'printf "%s\n" "--- Complete unittest suite ---"; mise exec -- python -m unittest discover -s tests -p "test_*.py"'
@cli! bash -lic 'printf "%s\n" "--- Installed Boundary CLI surface ---"; mise exec -- boundary --version && mise exec -- boundary --help && mise exec -- boundary contracts --help && mise exec -- boundary contracts authorize --help && mise exec -- boundary verify --help'
@cli! bash -lic 'printf "%s\n" "--- Boundary integration health ---"; mise exec -- boundary integration check && test ! -e .specify/boundary-runtime'
@cli! bash -lic 'printf "%s\n" "--- Repository whitespace checks ---"; git diff --check && git diff --cached --check'
@cli! bash -lic 'printf "%s\n" "--- Canonical changed code/documentation line counts, including untracked files ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; case "$file" in .agents/*|.specify/*|.boundary/*|.specdd/*) continue ;; esac; case "$file" in *.py|*.md|*.toml|*.yml|*.yaml) lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi ;; esac; done < <({ git diff --name-only --diff-filter=ACMR; git diff --cached --name-only --diff-filter=ACMR; git ls-files --others --exclude-standard; } | LC_ALL=C sort -u); exit "$failed"'
@cli! bash -lic 'printf "%s\n" "--- Repository status ---"; git status --short'
@# ALWAYS MAINTAIN AN ATLAS CALL, AS WELL AS ITS --HELP CALL: WE USE THEM FOR CODEBASE AWARENESS: BUDGET IS 4096, can be higher.
@cli atlas --help
@cli atlas --budget 4096 --focus .
