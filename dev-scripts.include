@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=integration/speckit/scripts:tests:src uv run --no-project python -m unittest -q tests.test_lifecycle_outcomes tests.test_spec_kit_scope_preflight tests.test_spec_kit_adapter tests.test_spec_kit_gate tests.test_spec_kit_task_selection tests.test_authorization_lifecycle tests.test_authorization_model tests.test_fresh_authorization tests.test_native_verification tests.test_operation_record tests.test_task_selected_units"
@cli! bash -lic "python -c 'from pathlib import Path; files=list(Path(\"integration/speckit/scripts\").glob(\"*.py\")); files += list(Path(\"src/boundary/authorization\").rglob(\"*.py\")); files += list(Path(\"src/boundary/verification\").rglob(\"*.py\")); files += [Path(\"src/boundary/outcomes.py\"),Path(\"tests/test_lifecycle_outcomes.py\"),Path(\"tests/test_spec_kit_scope_preflight.py\"),Path(\"tests/test_spec_kit_adapter.py\"),Path(\"tests/test_spec_kit_gate.py\"),Path(\"tests/test_spec_kit_task_selection.py\"),Path(\"tests/test_authorization_lifecycle.py\"),Path(\"tests/test_authorization_model.py\"),Path(\"tests/test_fresh_authorization.py\"),Path(\"tests/test_native_verification.py\"),Path(\"tests/test_operation_record.py\"),Path(\"tests/test_task_selected_units.py\"),Path(\"docs/spec-lifecycle.md\")]; files=sorted(set(files)); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files if p.is_file()]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in oversized if count > 250]'"
