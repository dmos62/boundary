@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run dev-install >/dev/null && python -m unittest tests/test_spec_kit_script_modes.py tests/test_authorization_lifecycle.py tests/test_fresh_authorization.py tests/test_lifecycle_outcomes.py tests/test_native_verification.py tests/test_operation_record.py tests/test_operation_record_task_selection.py tests/test_task_selected_units.py"
@cli! bash -lic "printf '%s\n' '--- Operation-kind and contract-evolution separation ---'; git grep -n -E 'contract-evolution|implementation operation|contract files|OPERATION_KIND|CONTRACT.*WRITE|fresh implementation authorization|dependent implementation' -- docs/spec.md docs/spec-authorization.md docs/spec-contracts.md docs/spec-lifecycle.md skills/implement/SKILL.md skills/contracts/SKILL.md src/boundary/authorization src/boundary/verification tests/test_authorization_lifecycle.py tests/test_native_verification.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Scope expansion and undeclared-write enforcement ---'; git grep -n -E 'UNDECLARED_WRITE|scope-expansion|scope expansion|selected task|fresh authorization|authorizedTargets|authorized_targets|select_tasks' -- docs/spec.md docs/spec-authorization.md docs/spec-lifecycle.md docs/spec-change-adapter.md src/boundary/authorization src/boundary/verification integration/speckit/runtime/boundary_host tests/test_authorization_lifecycle.py tests/test_fresh_authorization.py tests/test_native_verification.py tests/test_task_selected_units.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Historical authority and changed-context verification ---'; git grep -n -E 'historical|current task|mutable planning|contractGraph|contract_graph|effectiveContext|effective_context|HEAD|Git-derived|git.*diff|actual writes|CONTEXT|OWNER' -- docs/spec-authorization.md docs/spec-lifecycle.md src/boundary/authorization src/boundary/context src/boundary/repository src/boundary/verification tests/test_fresh_authorization.py tests/test_native_verification.py tests/test_operation_record.py 2>/dev/null || true"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
