@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Spec Kit follow-up ownership references ---"; git grep -n -E "Writes:|follow-up|follow up|reopen|refine|duplicate|unique task|task ownership|selectedTaskIds|fresh authorization|feature correctness|feature completion|live acceptance" -- integration/speckit skills docs/spec-change-adapter.md docs/spec-lifecycle.md 2>/dev/null || true'
@cli! bash -lic 'printf "%s\n" "--- Spec Kit integration source tree ---"; find integration/speckit -maxdepth 5 -type f | sort'
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
