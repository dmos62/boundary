@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic 'printf "%s\n" "--- Remaining migration terminology outside explicit history ---"; git grep -n -E "SpecDD|speckit\\.specdd|change-boundary|integration/specdd|specdd-preset|\\.specdd/" -- src adapters integration scripts skills tests README.md AGENTS.md CLAUDE.md docs ":!docs/history/**" ":!docs/TODO.md" 2>/dev/null | head -120 || true'
@cli! bash -lic 'printf "%s\n" "--- Files over 250 lines ---"; find src adapters integration scripts skills tests docs -type f \( -name "*.py" -o -name "*.sh" -o -name "*.md" -o -name "*.yml" -o -name "*.yaml" \) -not -path "*/__pycache__/*" -print0 2>/dev/null | xargs -0 -r wc -l | awk "\$1 > 250 && \$2 != \"total\" {print}"'
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_native_*.py'"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_authorization*.py'"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_operation_record.py'"
@cli! bash -lic "PYTHONPATH=src:integration/speckit/scripts uv run --no-project python -m unittest discover -s tests -p 'test_spec_kit_adapter*.py'"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_preset.py'"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer*.py'"
@cli! bash -lic "if [[ -f tests/fixtures/consumer-release/boundary.lock.json && -f tests/fixtures/consumer-release/boundary-upgrade.lock.json ]]; then BOUNDARY_RELEASE_ARCHIVE_TESTS=1 PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer_release.py'; else printf '%s\n' 'release archive fixture not committed'; fi"
@cli! bash -lic 'printf "%s\n" "--- P10 anonymous publication readiness ---"; repo=https://github.com/dmos62/speckit-specdd; status=$(curl -L -sS -o /dev/null -w "%{http_code}" "$repo" 2>/dev/null || true); printf "repository_url=%s\nrepository_http=%s\n" "$repo" "${status:-<unavailable>}"; for commit in ab7302e1d6986e0ce0db9ac8a567999e6aa3a50e b43741a19ce12cc408fd493c25df17541e5a46c9; do url="$repo/archive/$commit.tar.gz"; archive=$(mktemp); if curl -fLsS --retry 2 "$url" -o "$archive"; then sha=$(sha256sum "$archive" | awk "{print \$1}"); printf "revision=%s\nurl=%s\nsha256=%s\n" "$commit" "$url" "$sha"; else printf "revision=%s\nurl=%s\nsha256=<anonymous-download-unavailable>\n" "$commit" "$url"; fi; rm -f "$archive"; done'
