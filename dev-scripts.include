@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Canonical Boundary-owned lock references ---"; git grep -n -F "boundary.lock.json" -- integration/speckit integration/speckit-preset adapters/codex skills src docs pyproject.toml 2>/dev/null || true'
@cli! bash -lic "mise exec -- python -m unittest discover -s tests -p 'test_mise_distribution_integration.py' -v"
@cli! bash -lic 'printf "%s\n" "--- Focused distribution/materialization diff ---"; git diff -- TODO.md integration/speckit-preset/commands/tasks.md integration/speckit integration/speckit-preset adapters/codex skills tests/test_mise_distribution_integration.py'
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
