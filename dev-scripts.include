@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise exec -- python -m unittest discover -s tests -p 'test_contract_evolution_cli.py' -v"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Boundary CLI surface ---"; mise exec -- boundary --version; mise exec -- boundary --help; printf "%s\n" "--- boundary contracts help ---"; mise exec -- boundary contracts --help; printf "%s\n" "--- boundary contracts authorize help ---"; mise exec -- boundary contracts authorize --help'
@cli! bash -lic 'printf "%s\n" "--- Contract-evolution implementation references ---"; git grep -n -E "authorize_contract_evolution_operation|contract[-_ ]evolution|CONTRACT_EVOLUTION|contract evolution|contracts authorize" -- src skills tests docs pyproject.toml 2>/dev/null | head -n 260 || true'
@cli! bash -lic 'printf "%s\n" "--- CLI parser and dispatch references ---"; git grep -n -E "ArgumentParser|add_parser|add_subparsers|def main|console_scripts|project.scripts" -- src pyproject.toml 2>/dev/null | head -n 220 || true'
@cli! bash -lic 'printf "%s\n" "--- Focused contract-evolution diff ---"; git diff -- TODO.md files.include dev-scripts.include pyproject.toml src/boundary/cli skills/contracts tests/test_contract_evolution_cli.py docs/spec-contracts.md docs/spec-authorization.md docs/spec-lifecycle.md docs/spec-agent-instructions.md'
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
