@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=src:integration/speckit/scripts:scripts uv run --no-project python -m unittest discover -s tests -p 'test_consumer*.py'"
@cli! bash -lic "uv run --no-project python -m unittest discover -s tests -p 'test_install_host_script_mode.py'"
@cli! bash -lic 'log="$(mktemp)"; if bash scripts/bootstrap.sh >"$log" 2>&1 && bash scripts/bootstrap.sh --check >>"$log" 2>&1; then printf "%s\n" "bootstrap: ok"; rm -f "$log"; else cat "$log"; rm -f "$log"; exit 1; fi'
@cli! bash -lic 'if [[ "$(uname -s)" == "Linux" ]]; then mode="$(uv run --no-project python -c '"'"'import json; print(json.load(open(".specify/init-options.json"))["script"])'"'"')"; [[ "$mode" == "sh" ]] || { printf "unexpected Linux Spec Kit script mode: %s\n" "$mode" >&2; exit 1; }; printf "%s\n" "linux script mode: sh"; else printf "%s\n" "linux script mode check: skipped"; fi'
@cli! bash -lic 'if command -v pwsh >/dev/null 2>&1; then printf "%s\n" "powershell prerequisite: skipped (pwsh installed)"; else repo="$(pwd -P)"; tmp="$(mktemp -d)"; log="$(mktemp)"; mkdir -p "$tmp/.specify"; printf "%s\n" "{\"script\":\"ps\"}" >"$tmp/.specify/init-options.json"; if (cd "$tmp" && bash "$repo/scripts/install.sh" --check >"$log" 2>&1); then cat "$log"; rm -rf "$tmp"; rm -f "$log"; exit 1; fi; grep -F "Spec Kit PowerShell script mode requires pwsh" "$log" >/dev/null || { cat "$log"; rm -rf "$tmp"; rm -f "$log"; exit 1; }; rm -rf "$tmp"; rm -f "$log"; printf "%s\n" "powershell prerequisite: ok"; fi'
@cli! bash -lic 'printf "%s\n" "--- Files over 250 lines ---"; find scripts tests docs contracts -type f \( -name "*.py" -o -name "*.sh" -o -name "*.md" -o -name "*.yml" -o -name "*.yaml" \) -not -path "*/__pycache__/*" -print0 2>/dev/null | xargs -0 -r wc -l | awk "\$1 > 250 && \$2 != \"total\" {print}"'
