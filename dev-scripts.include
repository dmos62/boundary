@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -q tests.test_authorization_model tests.test_fresh_authorization tests.test_native_verification tests.test_task_selected_units tests.test_spec_kit_task_selection tests.test_spec_kit_gate tests.test_spec_kit_adapter"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -q tests.test_install_real_cli"
@cli! bash -lic "python -c 'from pathlib import Path; roots=(Path(\"src/boundary/authorization\"),Path(\"src/boundary/verification\"),Path(\"integration/speckit\"),Path(\"tests\")); suffixes={\".py\",\".md\",\".yml\",\".yaml\"}; files=(p for root in roots if root.exists() for p in root.rglob(\"*\") if p.is_file() and p.suffix in suffixes and \"__pycache__\" not in p.parts); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in sorted(oversized) if count > 250]'"
