@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=integration/speckit/scripts:tests:src uv run --no-project python -m unittest -q tests.test_authorization_handoff tests.test_boundary_status_cli tests.test_spec_kit_adapter tests.test_spec_kit_discovery tests.test_spec_kit_gate tests.test_spec_kit_task_selection tests.test_native_contract_cli tests.test_task_selected_units"
@cli! bash -lic "python -c 'from pathlib import Path; files=list(Path(\"integration/speckit/scripts\").glob(\"*.py\")); files += list(Path(\"src/boundary/authorization\").rglob(\"*.py\")); files += list(Path(\"src/boundary/cli\").rglob(\"*.py\")); files += [Path(\"src/boundary/__main__.py\"),Path(\"src/boundary/outcomes.py\"),Path(\"tests/test_authorization_handoff.py\"),Path(\"tests/test_boundary_status_cli.py\"),Path(\"tests/test_spec_kit_adapter.py\"),Path(\"tests/test_spec_kit_discovery.py\"),Path(\"tests/test_native_contract_cli.py\"),Path(\"docs/spec.md\"),Path(\"docs/spec-authorization.md\"),Path(\"docs/spec-change-adapter.md\"),Path(\"docs/spec-lifecycle.md\")]; files=sorted(set(files)); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files if p.is_file()]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in oversized if count > 250]'"
