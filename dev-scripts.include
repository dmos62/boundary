@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=scripts:tests:src uv run --no-project python -m unittest -v tests.test_agent_skills tests.test_agent_skill_materialization tests.test_spec_kit_adapter tests.test_preset tests.test_install_host_script_mode"
@cli! bash -lic "python -c 'from pathlib import Path; files=[Path(\"skills/scope/SKILL.md\"),Path(\"tests/test_agent_skills.py\"),Path(\"tests/test_agent_skill_materialization.py\"),Path(\"tests/test_spec_kit_adapter.py\"),Path(\"tests/test_install_host_script_mode.py\"),Path(\"scripts/bootstrap.sh\")]; files += list(Path(\"integration/speckit/scripts\").glob(\"*.py\")); files += [p for p in Path(\"integration/speckit-preset\").rglob(\"*\") if p.is_file()]; files += list(Path(\"scripts\").glob(\"install*.sh\")); files += list(Path(\"tests\").glob(\"preset_test_*.py\")); files=sorted(set(files)); oversized=[(sum(1 for _ in p.open(encoding=\"utf-8\",errors=\"replace\")),p) for p in files if p.is_file()]; print(\"--- Files over 250 lines ---\"); [print(f\"{count} {path}\") for count,path in oversized if count > 250]'"
