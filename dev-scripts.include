@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic 'printf "%s\n" "--- Remaining migration terminology outside explicit history ---"; git grep -n -E "SpecDD|speckit\\.specdd|change-boundary|integration/specdd|specdd-preset|\\.specdd/" -- src adapters integration scripts skills tests README.md AGENTS.md CLAUDE.md docs ":!docs/history/**" ":!docs/TODO.md" 2>/dev/null | head -120 || true'
@cli! bash -lic 'printf "%s\n" "--- Files over 250 lines ---"; find src adapters integration scripts skills tests docs -type f \( -name "*.py" -o -name "*.sh" -o -name "*.md" -o -name "*.yml" -o -name "*.yaml" \) -not -path "*/__pycache__/*" -print0 2>/dev/null | xargs -0 -r wc -l | awk "\$1 > 250 && \$2 != \"total\" {print}"'
@cli! bash -lic "bash scripts/bootstrap.sh && bash scripts/bootstrap.sh --check"
@cli! bash -lic "PYTHONPATH=src:integration/speckit/scripts uv run --no-project python -m unittest discover -s tests -p 'test_*.py'"
@cli! bash -lic "BOUNDARY_RELEASE_ARCHIVE_TESTS=1 PYTHONPATH=src:integration/speckit/scripts uv run --no-project python -m unittest discover -s tests -p 'test_consumer_release.py'"
