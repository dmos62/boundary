@cli! bash -lic "mise run contracts-check"
@cli! bash -lic "mise run dev-install >/dev/null && python -m unittest tests/test_operation_record.py tests/test_operation_record_task_selection.py tests/test_authorization_handoff.py tests/test_boundary_status_cli.py tests/test_spec_kit_runtime_projection.py tests/test_native_verification.py"
@cli! bash -lic "printf '%s\n' '--- Operation-record internal consistency ---'; git grep -n -E 'authorizedTargets|authorized_targets|selectedTaskIds|selected_task_ids|effectiveContextIdentity|effective_context_identity|target owner|task writes|OperationRecord' -- docs/spec-authorization.md contracts/boundary-authorization.contract.md src/boundary/authorization tests/test_operation_record.py tests/test_operation_record_task_selection.py tests/test_authorization_handoff.py tests/test_native_verification.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Spec Kit status-query specification versus runtime ---'; git grep -n -E 'status query|boundary status|authorization handoff|active feature|change identity matches|run_status|status_feature|status' -- docs/spec.md docs/spec-authorization.md docs/spec-change-adapter.md docs/spec-lifecycle.md docs/spec-agent-instructions.md contracts/boundary-change-adapter.contract.md src/boundary/cli integration/speckit/runtime/boundary_host tests/test_authorization_handoff.py tests/test_boundary_status_cli.py tests/test_spec_kit_runtime_projection.py 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Review1-era concepts outside history/generated state ---'; git grep -n -E 'feature-wide|flattened authorization|synthetic task|Change Boundary|context fingerprint|validation (phase|stage)|copied runtime|boundary-runtime|boundary\\.lock|project-local launcher|PowerShell|pwsh|implicit scope expansion' -- ':!docs/history/**' ':!.agents/**' ':!.specify/**' ':!.boundary/**' 2>/dev/null || true"
@cli! bash -lic "printf '%s\n' '--- Legacy invocation leakage outside history/generated state ---'; git grep -n -E 'PYTHONPATH|UV_CACHE_DIR|python -m boundary|adapter_gate\\.py|\\.specify/boundary-runtime|boundary\\.lock\\.json' -- ':!docs/history/**' ':!.agents/**' ':!.specify/**' ':!.boundary/**' 2>/dev/null || true"
@cli! bash -lic "git diff --check"
@cli! bash -lic 'printf "%s\n" "--- Changed code/documentation line counts ---"; failed=0; while IFS= read -r file; do [ -f "$file" ] || continue; lines=$(wc -l < "$file"); printf "%4d %s\n" "$lines" "$file"; if [ "$lines" -gt 250 ]; then failed=1; fi; done < <(git diff --name-only --diff-filter=ACMR -- "*.py" "*.md" "*.toml" "*.yml" "*.yaml"); exit "$failed"'
@cli! bash -lic "git status --short"
