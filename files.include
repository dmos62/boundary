@filegroup
@glob AGENTS.md
@glob TODO.md
@glob files.include
@glob dev-scripts.include

@glob docs/spec.md
@glob docs/spec-change-adapter.md
@glob docs/spec-lifecycle.md
@glob docs/spec-distribution.md
@glob docs/spec-distribution-state.md

@glob skills/implement/SKILL.md
