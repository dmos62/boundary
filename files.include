@globexclude tests/test_spec_kit_runtime_projection.py

@globexclude src/boundary/__init__.py
@globexclude src/boundary/cli/__init__.py

@globexclude CLAUDE.md
@globexclude HUMAN-REQUEST-UPSTREAM-SPECDD-CLI.md
@globexclude docs/history/**
