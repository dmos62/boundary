@filegroup
@glob *.md
@glob docs/*.md
@glob contracts/*.contract.md
@glob tests/*.py
@globexclude HUMAN-REQUEST-UPSTREAM-SPECDD-CLI.md
@globexclude docs/history/**
@globexclude tests/test_consumer_release.py
@globexclude tests/test_consumer_lock.py
@globexclude tests/test_consumer_lifecycle.py
@globexclude tests/consumer_test_support.py
@globexclude tests/test_spec_kit_adapter*.py
@globexclude tests/test_native_*.py
@globexclude tests/fixtures/**
@globexclude tests/__pycache__/**
@globexclude **/__pycache__/**
@globexclude **/*.pyc
@globexclude .agents/**
@globexclude .specify/**
@globexclude .specdd/**
@endfilegroup
