@filegroup
@glob AGENTS.md
@glob TODO.md
@glob files.include
@glob dev-scripts.include

@# next focus: rerun full validation after making the distribution help assertion wrapping-insensitive
@glob pyproject.toml
@glob docs/spec.md
@glob docs/spec-distribution.md

@glob src/boundary/cli/main.py
@glob tests/test_distribution_surface.py

@globexclude README.md
@globexclude docs/setup-development.md
@globexclude docs/setup-downstream.md
@globexclude docs/spec-lifecycle.md
@globexclude docs/spec-authorization.md
@globexclude docs/spec-change-adapter.md
