@filegroup
@glob AGENTS.md
@glob TODO.md
@glob DEBUGGING.md
@glob files.include
@glob dev-scripts.include
@glob ../gui-auto2/BOUNDARY-UPSTREAM-REPORT*

@glob docs/spec.md
@glob docs/spec-architecture.md
@glob docs/spec-authorization.md
@glob docs/spec-change-adapter.md
@glob docs/spec-lifecycle.md
@glob contracts/boundary-change-adapter.contract.md

@glob src/boundary/**/*.py
@glob integration/speckit/**
@glob skills/**

@globexclude pyproject.toml
@globexclude mise.toml
@globexclude README.md
@globexclude docs/setup-development.md
@globexclude docs/setup-downstream.md
@globexclude docs/spec-distribution.md
@globexclude docs/spec-distribution-state.md
@globexclude docs/spec-contracts.md
@globexclude docs/spec-agent-instructions.md
@globexclude contracts/boundary-repository-tooling.contract.md

@globexclude adapters/**
@globexclude tests/**

@globexclude src/boundary/**/__pycache__/**
@globexclude src/boundary/**/*.pyc
@globexclude src/boundary/__init__.py
@globexclude src/boundary/cli/__init__.py

@globexclude integration/speckit/runtime/boundary_host/__pycache__/**
@globexclude integration/speckit/runtime/boundary_host/**/*.pyc

@globexclude .agents/**
@globexclude .boundary/**
@globexclude .specify/**
@globexclude .specdd/**
@globexclude **/__pycache__/**
@globexclude **/*.pyc
@endfilegroup
