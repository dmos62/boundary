@glob integration/speckit/commands/**
@glob integration/speckit/extension.yml
@glob integration/speckit/workflow-overlay.yml
@glob integration/speckit/runtime/boundary_host/assets.py
@glob integration/speckit/runtime/boundary_host/commands.py
